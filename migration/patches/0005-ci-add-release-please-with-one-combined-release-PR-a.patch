From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 16:39:21 +0000
Subject: [PATCH 5/8] ci: add release-please with one combined release PR and
 GitHub Releases
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- release-please-config.json: one combined release PR (separate-pull-requests: false), per-folder versions, changelogs, GitHub Releases and <component>-v<version> tags for the four tools and recipes; breaking changes bump the minor version on 0.x. Python tools and recipes use the simple type (hatch-vcs reads the version from the tag), query-tool the node type.
- changelog-sections: the sections of the earlier auto changelogs (🚀 Enhancements, 🐛 Bug Fixes, 🏎 Performance Improvements, 🏠 Internal). docs, test, chore, ci, build and style are hidden, so they never trigger a release (release-please releases only when the changelog entry is not empty).
- .release-please-manifest.json seeded from each folder's last tag; bootstrap-sha is the last import commit.
- release.yml: release-please with the bot app token (release PRs trigger CI); per-folder release outputs for the publishing jobs; an "Authors" list added to each new GitHub Release, as auto's changelogs had.
---
 .github/workflows/release.yml | 94 +++++++++++++++++++++++++++++++++++
 .release-please-manifest.json |  7 +++
 release-please-config.json    | 44 ++++++++++++++++
 3 files changed, 145 insertions(+)
 create mode 100644 .github/workflows/release.yml
 create mode 100644 .release-please-manifest.json
 create mode 100644 release-please-config.json

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 00000000..cf23846d
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,94 @@
+name: release
+
+# release-please keeps one combined release PR for all tools and recipes (versions,
+# changelogs). Merging it makes release-please create one GitHub Release, and with it the
+# tag <component>-v<version>, per released folder. Its outputs then start the publishing
+# jobs below.
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+jobs:
+  release-please:
+    runs-on: ubuntu-latest
+    outputs:
+      recipes: ${{ steps.rp.outputs['recipes--release_created'] }}
+      recipes-version: ${{ steps.rp.outputs['recipes--version'] }}
+      api: ${{ steps.rp.outputs['tools/api--release_created'] }}
+      api-version: ${{ steps.rp.outputs['tools/api--version'] }}
+      federation-api: ${{ steps.rp.outputs['tools/federation-api--release_created'] }}
+      federation-api-version: ${{ steps.rp.outputs['tools/federation-api--version'] }}
+      query-tool: ${{ steps.rp.outputs['tools/query-tool--release_created'] }}
+      query-tool-version: ${{ steps.rp.outputs['tools/query-tool--version'] }}
+      configure-nb: ${{ steps.rp.outputs['tools/configure-nb--release_created'] }}
+      configure-nb-version: ${{ steps.rp.outputs['tools/configure-nb--version'] }}
+    steps:
+      - name: Generate a token
+        id: generate-token
+        uses: actions/create-github-app-token@v3
+        with:
+          app-id: ${{ vars.NB_BOT_ID }}
+          private-key: ${{ secrets.NB_BOT_KEY }}
+
+      # The bot token makes release PRs trigger CI (GITHUB_TOKEN PRs do not).
+      - name: Run release-please
+        id: rp
+        uses: googleapis/release-please-action@v5
+        with:
+          token: ${{ steps.generate-token.outputs.token }}
+          config-file: release-please-config.json
+          manifest-file: .release-please-manifest.json
+
+      - name: Show outputs
+        env:
+          OUTPUTS: ${{ toJSON(steps.rp.outputs) }}
+        run: echo "$OUTPUTS"
+
+      - name: Checkout (with the new tags)
+        if: steps.rp.outputs.releases_created == 'true'
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+
+      # The auto changelogs used before the monorepo listed the authors of each release;
+      # release-please does not. Adds "#### Authors: N" (the GitHub users who authored the
+      # released commits and the commits of their pull requests; bots left out) to each new
+      # GitHub Release. Safe to rerun: a release that has the list is skipped.
+      - name: Add the authors to the GitHub Releases
+        if: steps.rp.outputs.releases_created == 'true'
+        env:
+          GH_TOKEN: ${{ steps.generate-token.outputs.token }}
+          GH_REPO: ${{ github.repository }}
+          PATHS: ${{ steps.rp.outputs.paths_released }}
+          OUTPUTS: ${{ toJSON(steps.rp.outputs) }}
+        run: |
+          for path in $(jq -r '.[]' <<<"$PATHS"); do
+            tag="$(jq -r --arg k "${path}--tag_name" '.[$k]' <<<"$OUTPUTS")"
+            body="$(gh release view "$tag" --json body --jq .body)"
+            if grep -q '^#### Authors:' <<<"$body"; then echo "$tag: authors already listed"; continue; fi
+            prev="$(git describe --tags --abbrev=0 --match "${tag%-v*}-v*" "${tag}^" 2>/dev/null || true)"
+            : >authors.tsv
+            for sha in $(git rev-list "${prev:+${prev}..}${tag}" -- "$path"); do
+              gh api "repos/${GITHUB_REPOSITORY}/commits/${sha}" --jq '[.author.login // "", .commit.author.name] | @tsv' >>authors.tsv
+              for pr in $(gh api "repos/${GITHUB_REPOSITORY}/commits/${sha}/pulls" --jq '.[].number'); do
+                gh api --paginate "repos/${GITHUB_REPOSITORY}/pulls/${pr}/commits" \
+                  --jq '.[] | [.author.login // "", .commit.author.name] | @tsv' >>authors.tsv
+              done
+            done
+            list="$(awk -F'\t' '$1 != "" && $1 !~ /\[bot\]$/ && !seen[$1]++ {
+                      if ($2 == "" || $2 == $1) print "- [@" $1 "](https://github.com/" $1 ")";
+                      else print "- " $2 " ([@" $1 "](https://github.com/" $1 "))" }' authors.tsv | sort -f)"
+            if [ -z "$list" ]; then echo "$tag: no authors found"; continue; fi
+            printf '%s\n\n#### Authors: %s\n\n%s\n' "$body" "$(wc -l <<<"$list")" "$list" >notes.md
+            gh release edit "$tag" --notes-file notes.md
+            echo "$tag: $(wc -l <<<"$list") author(s)"
+          done
diff --git a/.release-please-manifest.json b/.release-please-manifest.json
new file mode 100644
index 00000000..f8423d01
--- /dev/null
+++ b/.release-please-manifest.json
@@ -0,0 +1,7 @@
+{
+  "recipes": "0.9.2",
+  "tools/api": "0.12.0",
+  "tools/federation-api": "0.10.0",
+  "tools/query-tool": "0.17.1",
+  "tools/configure-nb": "0.2.0"
+}
diff --git a/release-please-config.json b/release-please-config.json
new file mode 100644
index 00000000..8ad6ed40
--- /dev/null
+++ b/release-please-config.json
@@ -0,0 +1,44 @@
+{
+  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
+  "bootstrap-sha": "397d5d2f31f11b5e6525ddb284881be88149448d",
+  "separate-pull-requests": false,
+  "bump-minor-pre-major": true,
+  "include-component-in-tag": true,
+  "include-v-in-tag": true,
+  "tag-separator": "-",
+  "changelog-sections": [
+    { "type": "feat", "section": "🚀 Enhancements" },
+    { "type": "fix", "section": "🐛 Bug Fixes" },
+    { "type": "perf", "section": "🏎 Performance Improvements" },
+    { "type": "refactor", "section": "🏠 Internal" },
+    { "type": "revert", "section": "🏠 Internal" },
+    { "type": "docs", "section": "📝 Documentation", "hidden": true },
+    { "type": "test", "section": "🧪 Tests", "hidden": true },
+    { "type": "build", "section": "🔩 Dependency Updates", "hidden": true },
+    { "type": "chore", "section": "🏠 Internal", "hidden": true },
+    { "type": "ci", "section": "🏠 Internal", "hidden": true },
+    { "type": "style", "section": "🏠 Internal", "hidden": true }
+  ],
+  "packages": {
+    "recipes": {
+      "release-type": "simple",
+      "component": "recipes"
+    },
+    "tools/api": {
+      "release-type": "simple",
+      "component": "api"
+    },
+    "tools/federation-api": {
+      "release-type": "simple",
+      "component": "federation-api"
+    },
+    "tools/query-tool": {
+      "release-type": "node",
+      "component": "query-tool"
+    },
+    "tools/configure-nb": {
+      "release-type": "simple",
+      "component": "configure-nb"
+    }
+  }
+}
