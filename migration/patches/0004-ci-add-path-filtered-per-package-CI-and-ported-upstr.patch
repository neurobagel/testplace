+name: query-tool examples comment
+
+# Ported from query-tool's comment_examples_diff.yaml: posts the example results diff
+# computed by "query-tool examples" as a sticky PR comment (bot token).
+on:
+  workflow_run:
+    workflows: ["query-tool examples"]
+    types:
+      - completed
+
+permissions:
+  actions: read
+
+jobs:
+  post-comment:
+    runs-on: ubuntu-latest
+    if: github.event.workflow_run.event == 'pull_request' && github.event.workflow_run.conclusion == 'success'
+    steps:
+      - name: Download artifact
+        uses: actions/download-artifact@v8
+        with:
+          name: examples-diff-artifact
+          run-id: ${{ github.event.workflow_run.id }}
+          github-token: ${{ secrets.GITHUB_TOKEN }}
+          path: diff-artifact
+
+      - name: Generate comment markdown
+        id: prep
+        run: |
+          echo "pr_number=$(cat diff-artifact/pr_number.txt)" >> "$GITHUB_OUTPUT"
+          COMMENT_FILE="diff-artifact/comment.md"
+
+          if [ "$(cat diff-artifact/has_diff.txt)" = "true" ]; then
+            {
+              echo ""
+              echo "⚠️ **Changes detected** in the query tool results TSV(s) compared to \`testdata/query-tool-results\`:"
+
+              if [ -s diff-artifact/results.diff ]; then
+                echo ""
+                echo "<details open>"
+                echo "<summary><b>📄 neurobagel-query-results_YYYYMMDDHHMMSS.tsv</b></summary>"
+                echo ""
+                echo '```diff'
+                if [ $(wc -c < diff-artifact/results.diff) -gt 25000 ]; then
+                  head -c 25000 diff-artifact/results.diff
+                  echo ""
+                  echo "... [Diff truncated due to size limit. View workflow artifacts for full diff]"
+                else
+                  cat diff-artifact/results.diff
+                fi
+                echo '```'
+                echo "</details>"
+              fi
+
+              if [ -s diff-artifact/results_uris.diff ]; then
+                echo ""
+                echo "<details open>"
+                echo "<summary><b>📄 neurobagel-query-results-with-URIs_YYYYMMDDHHMMSS.tsv</b></summary>"
+                echo ""
+                echo '```diff'
+                if [ $(wc -c < diff-artifact/results_uris.diff) -gt 25000 ]; then
+                  head -c 25000 diff-artifact/results_uris.diff
+                  echo ""
+                  echo "... [Diff truncated due to size limit. View workflow artifacts for full diff]"
+                else
+                  cat diff-artifact/results_uris.diff
+                fi
+                echo '```'
+                echo "</details>"
+              fi
+            } > "$COMMENT_FILE"
+          else
+            {
+              echo ""
+              echo "✅ **No changes detected** in the query tool results TSVs compared to \`testdata/query-tool-results\`."
+            } > "$COMMENT_FILE"
+          fi
+
+      - name: Generate a token
+        id: generate-token
+        uses: actions/create-github-app-token@v3
+        with:
+          app-id: ${{ vars.NB_BOT_ID }}
+          private-key: ${{ secrets.NB_BOT_KEY }}
+          owner: ${{ github.repository_owner }}
+
+      - name: Post or update PR comment
+        uses: marocchino/sticky-pull-request-comment@v3
+        with:
+          GITHUB_TOKEN: ${{ steps.generate-token.outputs.token }}
+          header: query-tool-examples-diff-preview
+          number: ${{ steps.prep.outputs.pr_number }}
+          path: diff-artifact/comment.md
