+name: images validation
+
+# TEMPORARY (migration): for the validation phase; remove together with migration/.
+#
+# Manual: build every image and push it to the configured registry with a non-release tag
+# (validation-<short sha>), to validate the image builds without touching nightly, latest
+# or version tags.
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  packages: write
+
+jobs:
+  api:
+    uses: ./.github/workflows/docker-build.yml
+    with:
+      tool: api
+      image: api
+      tags: type=sha,prefix=validation-
+    secrets: inherit
+
+  federation-api:
+    uses: ./.github/workflows/docker-build.yml
+    with:
+      tool: federation-api
+      image: federation_api
+      tags: type=sha,prefix=validation-
+    secrets: inherit
+
+  query-tool:
+    uses: ./.github/workflows/docker-build.yml
+    with:
+      tool: query-tool
+      image: query_tool
+      tags: type=sha,prefix=validation-
+      platforms: linux/amd64
+      package-json-version: build:{short-sha}
+    secrets: inherit
