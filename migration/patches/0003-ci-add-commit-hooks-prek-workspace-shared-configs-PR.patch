+<!--
+PR title: a conventional commit, used as the squash commit message and by release-please:
+  <type>[(<scope>)][!]: <description>
+  type: feat, fix, perf, refactor, revert (release), or docs, test, chore, ci, build, style (no release)
+  scope (optional): api, federation-api, query-tool, configure-nb, recipes, examples
+  "!" marks a breaking change.
+
+A PR that changes more than one tool and should release several of them: use a
+non-releasing title (chore:, ci:, ...), make one conventional commit per tool (each
+touching only that tool), and merge with a MERGE COMMIT. See DEVELOPING.md. The
+"release-preview" job summary shows what release-please would propose.
+Never write the release-please override marker literally in this description; escape it as
+BEGIN\_COMMIT\_OVERRIDE when you mention it.
+-->
+
+- Closes #
+
+Changes proposed in this pull request:
+
+-
+
+## Checklist
+_This section is for the PR reviewer_
+
+- [ ] PR title is a conventional commit with the right type (it decides the release)
+- [ ] Multi-tool PR that releases: one conventional commit per tool, non-releasing title, merge with a merge commit
+- [ ] PR links to a GitHub issue with `Closes #XXXX`
+- [ ] Tests pass
+- [ ] Checks pass
+
+For new features:
+- [ ] Tests have been added
+
+For bug fixes:
+- [ ] There is at least one test that would fail under the original bug conditions.
diff --git a/.github/workflows/pr-checks.yml b/.github/workflows/pr-checks.yml
new file mode 100644
index 00000000..1da7b1c4
--- /dev/null
+++ b/.github/workflows/pr-checks.yml
@@ -0,0 +1,99 @@
+name: pr checks
+
+# PRs are squash-merged with the PR title as the commit message, and release-please reads
+# the commit messages: the title must be a conventional commit. Multi-tool PRs follow the
+# merge convention in DEVELOPING.md, checked at review with the release preview below.
+on:
+  pull_request:
+    types: [opened, edited, synchronize, reopened]
+
+permissions:
+  contents: read
+
+jobs:
+  pr-title:
+    runs-on: ubuntu-latest
+    permissions:
+      pull-requests: read
+    steps:
+      - name: Check the PR title
+        uses: amannn/action-semantic-pull-request@v6
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        with:
+          types: |
+            feat
+            fix
+            perf
+            revert
+            docs
+            style
+            refactor
+            test
+            build
+            ci
+            chore
+          # tools, recipes, examples; deps for Dependabot
+          scopes: |
+            api
+            federation-api
+            query-tool
+            configure-nb
+            recipes
+            examples
+            deps
+
+  # Informational: the versions and changelog entries release-please would propose if this
+  # PR's commits landed on main as they are (a merge commit; a squash gives every changed
+  # tool the PR title's entry instead). Written to the job summary; never blocks.
+  release-preview:
+    runs-on: ubuntu-latest
+    continue-on-error: true
+    steps:
+      - name: Set up Node.js
+        uses: actions/setup-node@v7
+        with:
+          node-version: "20"
+
+      - name: release-please dry run
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          # PRs from forks: the branch is not in this repository, so preview main
+          TARGET: ${{ github.event.pull_request.head.repo.full_name == github.repository && github.head_ref || 'main' }}
+        run: |
+          {
+            echo "## release-please dry run on \`$TARGET\`"
+            echo
+            echo '```'
+            npx --yes release-please@17.11.2 release-pr --dry-run \
+              --token "$GITHUB_TOKEN" --repo-url "$GITHUB_REPOSITORY" --target-branch "$TARGET" 2>&1 \
+              | grep -vE '^\s*$' || true
+            echo '```'
+          } | tee -a "$GITHUB_STEP_SUMMARY"
+
+  # The commit hooks (prek workspace: every tool's own .pre-commit-config.yaml, run from its
+  # folder, plus the root config), on all files.
+  prek:
+    if: github.event.action != 'edited'
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v7
+        with:
+          node-version: "20"
+
+      # query-tool's hooks (typecheck, lint, format) run its npm scripts
+      - name: Install query-tool dependencies
+        working-directory: tools/query-tool
+        run: npm ci
+
+      - name: Set up uv
+        uses: astral-sh/setup-uv@v7
+
+      - name: Run the hooks on all files
+        run: uvx prek@0.5.11 run --all-files --show-diff-on-failure
diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
new file mode 100644
index 00000000..19ddd20e
--- /dev/null
+++ b/.pre-commit-config.yaml
@@ -0,0 +1,34 @@
+# Repository-wide commit hooks, run by prek (https://github.com/j178/prek) in workspace mode.
+#
+# `prek install` at the root sets up everything: prek also finds each tool's own config
+# (tools/<tool>/.pre-commit-config.yaml) and runs it from inside the tool's folder, so the
+# tools' hooks and their configs work here exactly as in the old repositories. This file
+# only has the hooks for the repository-wide files. In CI the hooks run in the `prek` job of
+# .github/workflows/pr-checks.yml.
+default_install_hook_types: [pre-commit, post-merge]
+default_stages: [pre-commit]
+
+repos:
+  - repo: https://github.com/python-jsonschema/check-jsonschema
+    rev: 0.39.0
+    hooks:
+      - id: check-github-workflows
+        files: ^\.github/workflows/[^/]+\.ya?ml$
+      - id: check-dependabot
+
+  - repo: https://github.com/rhysd/actionlint
+    rev: v1.7.12
+    hooks:
+      - id: actionlint
+        files: ^\.github/workflows/[^/]+\.ya?ml$
+
+  - repo: local
+    hooks:
+      # Configs shared by several tools: shared/ -> the copies listed in shared/files.yaml
+      - id: sync-shared
+        name: shared configs copied into the tools
+        language: python
+        additional_dependencies: [pyyaml==6.0.3]
+        entry: python scripts/sync-shared.py
+        always_run: true
+        pass_filenames: false
diff --git a/scripts/sync-shared.py b/scripts/sync-shared.py
new file mode 100755
index 00000000..5a4b76c8
--- /dev/null
+++ b/scripts/sync-shared.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Copy the shared configs in shared/ into the tool folders, as listed in shared/files.yaml.
+
+Usage (from anywhere in the repository; needs PyYAML):
+  sync-shared.py           write every copy that differs from its source; exit 1 if any did
+  sync-shared.py --check   only report copies that differ; exit 1 if any do
+
+Runs as a commit hook (prek, root .pre-commit-config.yaml): a commit that changes a source
+gets its copies updated, to be added to the commit. A copy edited by hand is overwritten.
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+
+import yaml
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--check", action="store_true", help="report differences, write nothing")
+    opts = ap.parse_args()
+
+    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
+                          check=True).stdout.strip()
+    with open(os.path.join(root, "shared", "files.yaml"), encoding="utf-8") as f:
+        entries = yaml.safe_load(f) or []
+
+    problems, changed = [], []
+    for entry in entries:
+        source = entry["source"]
+        if not source.startswith("shared/"):
+            problems.append(f"{source}: sources must be in shared/")
+            continue
+        try:
+            with open(os.path.join(root, source), "rb") as f:
+                content = f.read()
+        except FileNotFoundError:
+            problems.append(f"{source}: missing")
+            continue
+        for copy in entry.get("copies") or []:
+            if not copy.startswith("tools/"):
+                problems.append(f"{copy}: copies must be inside a tool folder")
+                continue
+            path = os.path.join(root, copy)
+            current = open(path, "rb").read() if os.path.exists(path) else None
+            if current == content:
+                continue
+            changed.append(copy)
+            if not opts.check:
+                os.makedirs(os.path.dirname(path), exist_ok=True)
+                with open(path, "wb") as f:
+                    f.write(content)
+
+    for p in problems:
+        print(f"error: {p}")
+    verb = "differs from" if opts.check else "updated from"
+    for c in changed:
+        print(f"{c}: {verb} its source in shared/")
+    return 1 if problems or changed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/shared/files.yaml b/shared/files.yaml
new file mode 100644
index 00000000..a2dc0774
--- /dev/null
+++ b/shared/files.yaml
@@ -0,0 +1,9 @@
+# Configs shared by several tools: each source file in shared/ is copied to every path in
+# `copies` (inside the tool folders) by scripts/sync-shared.py, which runs as a commit hook
+# and in CI. Edit the source, never a copy. The copies are committed, so each tool folder
+# stays self-contained (and its old repository gets them through the mirror).
+#
+# - source: shared/<file>
+#   copies:
+#     - tools/<tool>/<file>
+[]
diff --git a/tools/query-tool/.pre-commit-config.yaml b/tools/query-tool/.pre-commit-config.yaml
new file mode 100644
index 00000000..bae44d63
--- /dev/null
+++ b/tools/query-tool/.pre-commit-config.yaml
@@ -0,0 +1,48 @@
+# Commit hooks for the query tool, run by prek (or pre-commit) from this folder.
+# The same checks as the husky hooks and lint-staged config (.husky/, lint-staged.config.js),
+# plus the spelling check that ran in CI (codespell.yml). They need `npm ci` in this folder.
+# husky keeps working on its own; use one or the other.
+default_install_hook_types: [pre-commit, post-merge]
+default_stages: [pre-commit]
+
+ci:
+  # pre-commit.ci has no node_modules
+  skip: [typecheck, lint, format]
+
+repos:
+  - repo: https://github.com/codespell-project/codespell
+    rev: v2.4.3
+    hooks:
+      - id: codespell
+        args: [--config=.codespellrc]
+        # .codespellrc's `skip` globs do not match the file paths pre-commit passes
+        exclude: (^|/)package-lock\.json$|\.css$|^\.codespellrc$
+
+  - repo: local
+    hooks:
+      # lint-staged: typecheck and lint when a ts/tsx file changes, format check on any change
+      - id: typecheck
+        name: typecheck
+        language: system
+        entry: npm run typecheck
+        files: \.(ts|tsx)$
+        pass_filenames: false
+      - id: lint
+        name: lint
+        language: system
+        entry: npm run lint:check
+        files: \.(ts|tsx)$
+        pass_filenames: false
+      - id: format
+        name: format check
+        language: system
+        entry: npm run format:check
+        pass_filenames: false
+      # .husky/post-merge: reinstall the dependencies when package.json changed in the merge
+      - id: npm-ci-after-merge
+        name: npm ci after merge
+        language: system
+        entry: bash -c 'git diff --quiet ORIG_HEAD HEAD -- package.json || npm ci'
+        stages: [post-merge]
+        always_run: true
+        pass_filenames: false
